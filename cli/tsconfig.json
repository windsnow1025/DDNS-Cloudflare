{
  "compilerOptions": {
    "target": "ESNext",
    "module": "nodenext",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "rootDir": "..",
    "outDir": "./dist",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true
  },
  "include": [
    "./**/*.ts",
    "../src/lib/Config.ts",
    "../src/lib/ConfigService.ts",
    "../src/lib/DDNS_Service.ts",
    "../src/lib/EncryptionService.ts",
    "../src/lib/Hash.ts"
  ]
}
